<?xml version="1.0" encoding="utf-8"?>
<!--
  PHASE2_AUTOUNATTEND_TEMPLATE_0.9.1.xml   REV.3 (2026-10-24)
  Template for the phase 2.3 second virtual DVD (autounattend.xml, DVD root).

  PASSWORD POLICY (user review section 6 - non-negotiable):
    * The account "fitwistest" is a DEDICATED, throwaway test account with a
      NON-EMPTY password. Blank-password accounts are NOT used.
    * The Value below is a PLACEHOLDER. At preparation time (phase 2.3,
      separate authorization) it is replaced locally with the real test
      password in a WORKING COPY at
      D:\HyperV-QH-Test\Media\autounattend-src\autounattend.xml.
    * The real password NEVER enters Git, logs, reports or the chat.
    * The working copy is deleted immediately after the DVD ISO is created;
      only the read-only DVD media keeps it (inherent to the technique).
    * PlainText=true means Windows Setup reads the value literally
      (Microsoft documented default). Microsoft also documents that
      PlainText=false (Base64) provides NO encryption or security
      advantage, so protection comes from the file lifecycle above, not
      from encoding.
    * The same password is supplied INTERACTIVELY as the PowerShell Direct
      guest credential (Get-Credential); it is not stored in any script.

  Placement note: the Password element precedes Name/Group, matching the
  SIM element ordering convention for LocalAccount.
-->
<unattend xmlns="urn:schemas-microsoft-com:unattend"
          xmlns:wcm="http://schemas.microsoft.com/WMIConfig/2002/State">
  <settings pass="oobeSystem">
    <component name="Microsoft-Windows-Shell-Setup"
               processorArchitecture="amd64" language="neutral"
               publicKeyToken="31bf3856ad364e35">
      <OOBE>
        <HideEULAPage>true</HideEULAPage>
        <HideOnlineAccountScreens>true</HideOnlineAccountScreens>
        <HideWirelessSetupInOOBE>true</HideWirelessSetupInOOBE>
        <HideOEMRegistrationScreen>true</HideOEMRegistrationScreen>
        <ProtectYourPC>3</ProtectYourPC>
      </OOBE>
      <UserAccounts>
        <LocalAccounts>
          <LocalAccount wcm:action="add">
            <Password>
              <Value>__FITWISE_TEST_PASSWORD__</Value>
              <PlainText>true</PlainText>
            </Password>
            <Name>fitwistest</Name>
            <Group>Administrators</Group>
          </LocalAccount>
        </LocalAccounts>
      </UserAccounts>
    </component>
  </settings>
</unattend>
